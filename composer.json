{
  "name": "zakariatlilani/cart",
  "description": "Laravel Shopping cart",
  "keywords": [
    "laravel",
    "Shopping cart"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "zakaria tlilani",
      "email": "tilanizakaria@gmail.com"
    }
  ],
  "require": {
    "illuminate/support": "^6|^7|^8|^9|^10|^11|^12|^13",
    "illuminate/session": "^6|^7|^8|^9|^10|^11|^12|^13",
    "illuminate/events": "^6|^7|^8|^9|^10|^11|^12|^13"
  },
  "require-dev": {
    "phpunit/phpunit": "~5.0 || ~6.0 || ~7.0 || ~10.0",
    "mockery/mockery": "~0.9.0",
    "orchestra/testbench": "~3.1"
  },
  "autoload": {
    "psr-4": {
      "zakariatlilani\\cart\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "zakariatlilani\\Tests\\cart\\": "tests/"
    }
  },
  "suggest": {
    "zakariatlilani/notify": "Simple flash notifications for Laravel"
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "zakariatlilani\\cart\\CartServiceProvider"
      ],
      "aliases": {
        "Cart": "zakariatlilani\\cart\\Facades\\Cart"
      }
    }
  }
}
